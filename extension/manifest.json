{
  "manifest_version": 3,
  "name": "Jarvis",
  "version": "0.6.0",
  "description": "Мост между голосовым ассистентом Jarvis и браузером: вкладки и управление тем, что в них открыто.",
  "permissions": ["tabs", "alarms", "scripting"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["page.js", "background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "jarvis@mcdima0001",
      "strict_min_version": "115.0"
    }
  }
}
