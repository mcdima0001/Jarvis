# Скопируй в .env и заполни. Файл .env в .gitignore — в репозиторий не попадёт.
# Конфиг подставляет эти значения через ${ИМЯ} в config/config.yaml.

# Ключ OpenRouter: https://openrouter.ai/keys
JARVIS_OPENROUTER_KEY=

# Адрес ESP32 в локальной сети
JARVIS_ESP32_HOST=192.168.1.50

# Telegram: ключи приложения, а не бота — бот видит только свои чаты.
# Берутся на my.telegram.org → API development tools. Вход в аккаунт
# делается один раз командой: python skills/telegram/login.py
JARVIS_TELEGRAM_API_ID=
JARVIS_TELEGRAM_API_HASH=
